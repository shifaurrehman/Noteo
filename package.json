{
  "name": "noteo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:local": "EXPO_PUBLIC_ENV=local expo start -c",
    "start:prod": "EXPO_PUBLIC_ENV=production expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "preflight": "npm run lint && npm run typecheck",
    "db:start": "json-server --watch db.json --port 3001",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:android:apk": "eas build -p android --profile preview",
    "build:android:prod": "eas build -p android --profile production",
    "build:ios:prod": "eas build -p ios --profile production",
    "clean:modules": "rm -rf node_modules && npm install",
    "clean:metro": "expo start -c",
    "clean:all": "rm -rf node_modules .expo && npm install"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/material-top-tabs": "^7.4.24",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.10.1",
    "@shopify/flash-list": "2.0.2",
    "@types/react-redux": "^7.1.34",
    "axios": "^1.13.2",
    "expo": "~54.0.22",
    "expo-blur": "^15.0.8",
    "expo-constants": "~18.0.10",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.14",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.9",
    "lottie-react-native": "~7.3.1",
    "moment": "^2.30.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-pager-view": "^8.0.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-shimmer-placeholder": "^2.0.9",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.4.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "^54.0.17",
    "react-test-renderer": "19.1.0",
    "reactotron-react-native": "^5.1.18",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "prettier": {
    "printWidth": 110,
    "tabWidth": 2,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always"
  },
  "private": true
}
